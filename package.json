    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "gh-pages": "^6.3.0",
    "sass": "^1.91.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
