{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://darkfall48.github.io/Portfolio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "cv:template": "node scripts/cv/build-template.mjs",
    "cv:inspect": "node scripts/cv/inspect-docx.mjs",
    "cv:extract": "node scripts/cv/extract-content.mjs",
    "cv:sample": "node scripts/cv/render-sample.mjs",
